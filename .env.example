# Which news source to use. Default is gdelt, which needs no key at all.
#   gdelt   — worldwide general news, no key, no sign-up (default)
#   newsapi — NewsAPI.org: categories + summaries, needs NEWS_API_KEY.
#             Free plan is DEVELOPMENT ONLY and will not serve a deployed origin.
#   snapi   — Spaceflight News API: space coverage only, no key
NEWS_PROVIDER=gdelt

# Only needed when NEWS_PROVIDER=newsapi. Get one at https://newsapi.org/register
# Read on the server only — it never reaches the browser bundle.
# NEWS_API_KEY=your-key-here
